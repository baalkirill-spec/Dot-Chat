    <string name="welcome_title">A modern messenger that starts with the essentials.</string>
    <string name="welcome_body">Open chats fast, keep your contacts close, follow channels, and manage sessions without the interface getting in your way.</string>
    <string name="welcome_primary">Start setup</string>
    <string name="welcome_secondary">Dot Chat is built around real-time conversations, strong account controls, media sharing up to 200 MB, and LiveKit-powered calls.</string>

